# 只能填写在本地 .env.local 中；不要把真实密钥提交到 Git。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方协议地址。使用兼容代理时可改为代理的完整接口 URL。
DEEPSEEK_RESPONSES_URL=https://api.deepseek.com/responses
DEEPSEEK_ANTHROPIC_MESSAGES_URL=https://api.deepseek.com/anthropic/v1/messages

REQUEST_TIMEOUT_SECONDS=60
MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.25

# 网关本地按模型独立限流，单位：每分钟请求数。
PRO_RATE_LIMIT_PER_MINUTE=30
FLASH_RATE_LIMIT_PER_MINUTE=60
METRICS_HISTORY_SIZE=1000
